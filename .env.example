# Solana Tracker API key (get from https://www.solanatracker.io/account)
NEXT_PUBLIC_DATA_API_KEY=your_data_api_key_here

# Solana Tracker Datastream WebSocket URL (Premium+ plans)
NEXT_PUBLIC_DATASTREAM_URL=wss://datastream.solanatracker.io/your_key_here

# Optional: override Data API base URL
# NEXT_PUBLIC_API_BASE=https://data.solanatracker.io
